    "tool": "Lighthouse 13.6.0",
    "node": "v24.21.0",
    "devices": "Default Lighthouse mobile and desktop presets, plus 320\u00d7720 mobile checks",
    "hosting": "Local Python HTTP servers; baseline git archive and current implementation served separately",
    "sampling": "One selected baseline and post-change run per page/device. Pages were measured after their individual layout changes; shared footer refinements were subsequently checked in the final homepage capture. Extra state/viewport runs verify expanded and fallback layouts. These are incremental checkpoints, not a controlled multi-run field benchmark.",
    "cautions": [
      "Local servers do not gzip responses; production GitHub Pages does.",
      "Single simulated runs and third-party responses vary. Small score/timing differences do not establish a meaningful speed change.",
      "Native expanded/fallback states were rendered from temporary copies of the same markup and assets, without changing published default states."
    ]
  },
