  "requirements": [
    {
      "item": 1,
      "change": "Repaired the visual arts document/head/navigation/wrapper hierarchy and standardized the navigation. Restored the clustering gallery already referenced by the section navigation, with three responsive previews; all 23 works link to full-resolution originals.",
      "evidence": [
        "tests/layout.test.cjs",
        "performance/aesthetics/screenshots/arts_visual.jpg"
      ]
    },
    {
      "item": 2,
      "change": "Removed the overriding white icon color/text shadow. Footer icons use dark gray with blue hover and focus-visible states. Existing text labels are also exposed through aria-label attributes across pages.",
      "evidence": [
        "assets/css/main.css",
        "performance/aesthetics/screenshots/footer.jpg",
        "tests/layout.test.cjs"
      ]
    },
    {
      "item": 3,
      "change": "All eleven software introductions are 32\u201340 words. Documentation is the primary action where available. Native Project details disclosures retain every original description, link, and badge. Expanded cards do not stretch neighbouring controls.",
      "evidence": [
        "tests/content-preservation.test.cjs",
        "performance/aesthetics/screenshots/software.jpg",
        "performance/aesthetics/screenshots/software-expanded-desktop.jpg",
        "performance/aesthetics/screenshots/software-expanded-mobile.jpg"
      ]
    },
    {
      "item": 4,
      "change": "News headlines appear above smaller muted dates and sources, with consistent entry spacing and separators. Every year group, headline, destination, date, source, and their order is unchanged.",
      "evidence": [
        "tests/content-preservation.test.cjs",
        "performance/aesthetics/screenshots/news.jpg"
      ]
    },
    {
      "item": 5,
      "change": "All 108 citations have separate author, title, and status blocks. Twenty-four long author lists use native disclosures enhanced with Show all authors/Hide author list labels. Lists stay open when the enhancement is unavailable. Author order, numbering, bold names (including previews), submitted underlining, titles, status, links, and badge metadata are preserved. Streaming enhancement prevents a full-list paint followed by collapse.",
      "evidence": [
        "tests/publication-authors.test.cjs",
        "performance/aesthetics/screenshots/publications.jpg",
        "performance/aesthetics/screenshots/publications-fallback.jpg",
        "performance/aesthetics/screenshots/publications-320.jpg"
      ]
    },
    {
      "item": 6,
      "change": "Reduced homepage outer and inner hero padding, retained the portrait/rotating phrases/accents, reserved space for wrapped text, and kept the scroll cue visible at 320 px. Existing reduced-motion and offscreen animation behavior is preserved.",
      "evidence": [
        "tests/home-effects.test.cjs",
        "performance/aesthetics/screenshots/index.jpg",
        "performance/aesthetics/screenshots/home-320.jpg"
      ]
    }
  ],
